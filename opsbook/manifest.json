{
  "key": "opsbook",
  "name": "OpsBook",
  "version": "0.0.6",
  "description": "Digitales Betreiberhandbuch für kleine Unternehmen. Zentrale Dokumentations- und Betriebsplattform für Standorte, Ansprechpartner, IT-Infrastruktur, Verträge, Notfallpläne und Dokumente.",
  "author": "smilch",
  "min_core_version": "0.1.0",
  "scope": "site",
  "capabilities": [],
  "deployment": {
    "type": "compose",
    "mode": "per_site",
    "service_name_template": "{site_slug}-opsbook",
    "compose_file_template": "modules/opsbook.compose.yml",
    "healthcheck_path": "/health"
  },
  "routes": {
    "frontend_template": "/sites/{site_slug}/modules/opsbook",
    "api_template": "/api/sites/{site_slug}/modules/opsbook"
  },
  "permissions": [
    "opsbook.read",
    "opsbook.write",
    "opsbook.review",
    "opsbook.configure",
    "opsbook.export"
  ],
  "required_core_tables": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "expiry_warning_days": {
        "type": "integer",
        "default": 30
      },
      "restore_test_max_months": {
        "type": "integer",
        "default": 3
      },
      "company_name": {
        "type": "string",
        "default": ""
      }
    }
  }
}
