{
  "key": "roomops",
  "name": "RoomOps",
  "version": "0.0.2",
  "description": "Digitale Housekeeping- und Zimmerstatus-Plattform. Operative Zimmerstatus-Prozesse zwischen Housekeeping, Rezeption, Supervisoren und Management.",
  "author": "smilch",
  "min_core_version": "0.1.0",
  "scope": "site",
  "capabilities": [
    "housekeeping",
    "room_status",
    "room_board",
    "status_history",
    "mobile_first"
  ],
  "deployment": {
    "type": "compose",
    "mode": "per_site",
    "service_name_template": "{site_slug}-roomops",
    "compose_file_template": "modules/roomops.compose.yml",
    "healthcheck_path": "/health"
  },
  "routes": {
    "frontend_template": "/sites/{site_slug}/modules/roomops",
    "api_template": "/api/sites/{site_slug}/modules/roomops"
  },
  "permissions": [
    "roomops.read",
    "roomops.operate",
    "roomops.inspect",
    "roomops.assign",
    "roomops.configure",
    "roomops.export"
  ],
  "required_core_tables": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "default_status_on_checkout": {
        "type": "string",
        "default": "dirty",
        "description": "Status bei Checkout-Meldung von der Rezeption"
      },
      "inspection_required": {
        "type": "boolean",
        "default": true,
        "description": "Supervisor-Inspektion (Inspected → Ready) ist Pflicht"
      },
      "cleaning_time_warning_minutes": {
        "type": "integer",
        "default": 30,
        "description": "Warnung wenn Reinigung länger als X Minuten dauert"
      },
      "priority_labels": {
        "type": "object",
        "default": {},
        "description": "Custom-Labels für Prioritäten, z.B. {\"vip\": \"VIP Check-In\"}"
      }
    }
  }
}
