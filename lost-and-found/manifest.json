{
  "key": "lost_found",
  "name": "Lost & Found",
  "version": "0.5.1",
  "description": "Fundstückverwaltung für Hotels, Events und Gastro. Foto-Erfassung, QR-Etiketten, Gast-Verlustmeldungen, DSGVO-konforme Aufbewahrungsfristen.",
  "author": "smilch",
  "min_core_version": "0.1.0",
  "scope": "site",
  "capabilities": [
    "lost_found",
    "qr_labels",
    "guest_reports"
  ],
  "deployment": {
    "type": "compose",
    "mode": "per_site",
    "service_name_template": "lost-found-site-{site_slug}",
    "compose_file_template": "modules/lost_found.compose.yml",
    "healthcheck_path": "/health"
  },
  "routes": {
    "frontend_template": "/sites/{site_slug}/modules/lost-found",
    "api_template": "/api/sites/{site_slug}/modules/lost-found"
  },
  "permissions": [
    "lost_found.read",
    "lost_found.operate",
    "lost_found.export",
    "lost_found.configure"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "retention_days": {
        "type": "integer",
        "default": 90,
        "description": "Aufbewahrungsfrist in Tagen ab Funddatum (DSGVO)"
      },
      "auto_dispose_enabled": {
        "type": "boolean",
        "default": false,
        "description": "Fundstücke nach Ablauf der Frist automatisch als entsorgt markieren"
      }
    }
  }
}
